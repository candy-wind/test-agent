# deploy.sh 首次运行会自动生成本文件（随机数据库密码 + APP_SECRET_KEY）
# 也可以复制为 .env 后手动修改；.env 已被 .gitignore 忽略，不要提交到仓库

# 对外端口（安全组需放行，或由 Nginx 反代）
APP_PORT=8080

# 数据库
DB_NAME=test_agent
DB_USERNAME=postgres
# 保留“换成强密码”时，deploy.sh 会自动生成随机密码并写回本文件
# 已有数据卷后不要修改此密码，否则数据库里的旧密码不会跟着变
# 若密码包含空格、# 等字符，请用双引号包裹，例如 DB_PASSWORD="a b#c"
DB_PASSWORD=换成强密码

# 模型 Key / 票房 Key 在数据库中的加密密钥，至少 32 位随机串
# 生成：openssl rand -base64 32
# 重要：有数据后不要再更换，否则已加密的 API Key 将无法解密
APP_SECRET_KEY=

# 日志子目录名，最终路径 /mnt/logs/${LOG_SERVICE_NAME}/app.log
LOG_SERVICE_NAME=test-agent

# 可选：使用阿里云 ACR 预构建镜像（留空则在服务器本地构建）
# 例：registry.cn-hangzhou.aliyuncs.com/<命名空间>/test-agent:1.0.0
APP_IMAGE=

# 可选：JVM 参数
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Duser.timezone=Asia/Shanghai
